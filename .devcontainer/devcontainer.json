{
  "name": "Icarus v2",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "containerEnv": {
    "APP_ALLOWED_HOSTS": "127.0.0.1,localhost,*.app.github.dev",
    "APP_BOOTSTRAP_DEMO_DATA": "true",
    "APP_AI_ENABLED": "true",
    "APP_ENV": "development"
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Icarus v2",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    }
  },
  "postStartCommand": "bash -lc 'pgrep -f \"uvicorn app.main:app\" >/dev/null || nohup uvicorn app.main:app --host 0.0.0.0 --port 8000 --proxy-headers > /tmp/icarus.log 2>&1 &'",
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb"
  }
}
