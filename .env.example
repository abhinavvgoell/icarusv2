APP_DATABASE_PATH=data/prototype.db
# Set this instead of APP_DATABASE_PATH for PostgreSQL. Apply the SQL schema first.
# APP_DATABASE_URL=postgresql://icarus:change-me@db.example.internal:5432/icarus
# Development defaults to synthetic demo records. Set false for any non-demo deployment.
APP_BOOTSTRAP_DEMO_DATA=true
APP_UPLOAD_DIR=data/uploads
APP_MAX_UPLOAD_BYTES=5242880
APP_MAX_PDF_PAGES=25
APP_AI_ENABLED=true
APP_AI_PROVIDER=local
# Optional external extraction; document text is sent only when explicitly enabled.
# APP_AI_PROVIDER=openai
# APP_LLM_MODEL=your-enabled-structured-output-model
# OPENAI_API_KEY=provided-by-your-organization
APP_OCR_LANGUAGE=eng
APP_SESSION_TTL_HOURS=8
APP_LOGIN_ATTEMPTS_PER_WINDOW=10
APP_LOGIN_WINDOW_SECONDS=900
APP_ALLOWED_HOSTS=127.0.0.1,localhost
APP_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
APP_STORAGE_BACKEND=local
APP_ENV=development
APP_MALWARE_SCAN_MODE=disabled
APP_LOG_LEVEL=INFO
APP_AUDIT_RETENTION_DAYS=2555
APP_AUTH_MODE=local
# Production requires APP_AUTH_MODE=oidc and a 32+ character secret below.
# APP_SESSION_COOKIE_SECRET=replace-with-a-secret-manager-value
# APP_OIDC_ISSUER=https://id.example.edu
# APP_OIDC_CLIENT_ID=icarus-production
# APP_OIDC_CLIENT_SECRET=replace-with-a-secret-manager-value
# APP_OIDC_ALLOWED_DOMAINS=example.edu
# Production: APP_MALWARE_SCAN_MODE=clamav
# APP_CLAMAV_HOST=clamav.internal
# APP_CLAMAV_PORT=3310
# For APP_STORAGE_BACKEND=s3, configure a private, encrypted bucket:
# APP_S3_BUCKET=icarus-production-documents
# APP_S3_PREFIX=icarus
# APP_S3_REGION=ap-south-1
# APP_S3_ENCRYPTION=aws:kms
# APP_S3_KMS_KEY_ID=alias/icarus-documents

